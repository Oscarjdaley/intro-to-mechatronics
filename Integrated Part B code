// PART B - standalone test sketch

const int redPin = 3;
const int greenPin = 5;
const int bluePin = 6;

const int potPin = A1;
const int ldrPin = A2;
const int darkThreshold = 800;

int colourTable[4][3] = {
  {0,   200, 40},
  {255, 120, 0},
  {140, 0,   255},
  {255, 0,   0}
};

// Current colour in the cycle
int currentColour = 0;

// Time at which the RGB LED colour was last changed
unsigned long lastColourChange = 0;

// How long each colour remains on
const unsigned long colourChangeInterval = 1000;

const int minimumBrightnessPwm = 25;

void setup() {
  pinMode(redPin, OUTPUT);
  pinMode(greenPin, OUTPUT);
  pinMode(bluePin, OUTPUT);
  pinMode(ldrPin, INPUT);

  // Make sure RGB LED starts OFF
  turnOffRGB();

  Serial.begin(9600);
  Serial.println("Part B standalone test starting...");
}

void loop() {
  // Continuously cycle colours and update brightness from the pot
  updateRGBColours();

  // Report LDR / dark status once a second, for visibility while testing
  static unsigned long lastReport = 0;
  if (millis() - lastReport >= 1000UL) {
    lastReport = millis();
    Serial.print("Colour index: ");
    Serial.print(currentColour);
    Serial.print(" | Dark enough: ");
    Serial.println(isDark() ? "YES" : "NO");
  }
}

bool isDark() {
  int ldrValue = analogRead(ldrPin);
  return ldrValue < darkThreshold;
}

// part B functions

void updateRGBColours()
{
  if (millis() - lastColourChange >= colourChangeInterval)
  {
    lastColourChange = millis();

    currentColour++;

    if (currentColour >= 4)
    {
      currentColour = 0;
    }
  }

  int potValue = analogRead(potPin);

  int brightness = map(potValue, 0, 1023, minimumBrightnessPwm, 255);

  int r = colourTable[currentColour][0];
  int g = colourTable[currentColour][1];
  int b = colourTable[currentColour][2];

  r = r * brightness / 255;
  g = g * brightness / 255;
  b = b * brightness / 255;

  // Invert the values because common-anode is active-low
  analogWrite(redPin, 255 - r);
  analogWrite(greenPin, 255 - g);
  analogWrite(bluePin, 255 - b);
}

// For a common anode RGB LED: 255 = off, 0 = on

void turnOffRGB()
{
  analogWrite(redPin, 255);
  analogWrite(greenPin, 255);
  analogWrite(bluePin, 255);
}

// NOTE: In the original combined sketch, the colour cycle only runs
// while systemState == 4 (i.e. after Part C's countdown finishes),
// and isDark() is used separately by Part A to gate the arm button.
// Here, with no Part A/C state machine present, updateRGBColours()
// just runs continuously in loop() so you can watch the colour cycle
// and pot-brightness behaviour on their own. isDark() is called only
// for the serial report - it is NOT wired to switch the LED off.

