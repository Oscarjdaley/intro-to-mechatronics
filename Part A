// A2 Part A: Hold-Time Input Module

const int armButtonPin = 2;
const int cancelButtonPin = 11;
const int statusLampPin = 13;

int systemState = 1;
int sharedValue = 0;
unsigned long holdStartTime = 0;

bool armButtonWasDown = false;
bool cancelButtonWasDown = false;
unsigned long shortHoldLimitMs = 2000;
unsigned long longHoldLimitMs = 5000;

void setup() {
  pinMode(armButtonPin, INPUT_PULLUP);
  pinMode(cancelButtonPin, INPUT_PULLUP);
  pinMode(statusLampPin, OUTPUT);
  digitalWrite(statusLampPin, LOW);
  Serial.begin(9600);
  Serial.println("Part A: Hold-Time Input");
}

void loop() {
  bool armDown = digitalRead(armButtonPin) == LOW;
  bool cancelDown = digitalRead(cancelButtonPin) == LOW;

  // Arm button pressed
  if (armDown && !armButtonWasDown && systemState == 1) {
    systemState = 2;
    holdStartTime = millis();
    Serial.println("Measuring started");
  }

  // Arm button released
  if (!armDown && armButtonWasDown && systemState == 2) {
    unsigned long heldForMs = millis() - holdStartTime;
    sharedValue = heldForMs / 1000;
    
    if (heldForMs < shortHoldLimitMs) {
      systemState = 3;
      Serial.print("SHORT HOLD: ");
    } else if (heldForMs < longHoldLimitMs) {
      systemState = 4;
      Serial.print("LONG HOLD: ");
    } else {
      systemState = 1;
      Serial.print("TOO LONG: ");
    }
    
    Serial.print(heldForMs);
    Serial.print("ms (");
    Serial.print(sharedValue);
    Serial.println("s)");
  }

  // Cancel button pressed
  if (cancelDown && !cancelButtonWasDown) {
    systemState = 1;
    sharedValue = 0;
    Serial.println("Reset");
  }

  updateStatusLamp();
  
  armButtonWasDown = armDown;
  cancelButtonWasDown = cancelDown;
}

void updateStatusLamp() {
  if (systemState == 2) {
    digitalWrite(statusLampPin, (millis() / 200) % 2);
  } 
  else if (systemState == 4) {
    digitalWrite(statusLampPin, HIGH);
  } 
  else {
    digitalWrite(statusLampPin, LOW);
  }
}
