const int redPin = 3;
const int greenPin = 5;
const int bluePin = 6;
const int potPin = A1;
const int ldrPin = A2;

int systemState = 1;          // table row, 1 to 4
int sharedValue = 0;          // ambient reading
unsigned long lastUpdate = 0; // table step timing

int colourTable[4][3] = {
  {0, 200, 40},
  {255, 120, 0},
  {140, 0, 255},
  {255, 0, 0}
};

int minimumPwm = 25;
int threshold = 500;

void setup() {
  pinMode(redPin, OUTPUT);
  pinMode(greenPin, OUTPUT);
  pinMode(bluePin, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  updateTableIndex();
  showSelectedColour();
  reportValues();
}

void updateTableIndex() {
  int pot = analogRead(potPin);
  int wait = map(pot, 0, 1023, 4000, 700);
  if (millis() - lastUpdate >= (unsigned long)wait) {
    lastUpdate = millis();
    systemState++;
    if (systemState > 4) systemState = 1;
  }
}

void showSelectedColour() {
  sharedValue = analogRead(ldrPin);
  int row = systemState - 1;
  int scale = map(analogRead(potPin), 0, 1023, minimumPwm, 255);
  int r = colourTable[row][0] * scale / 255;
  int g = colourTable[row][1] * scale / 255;
  int b = colourTable[row][2] * scale / 255;

  if (sharedValue > threshold) {
    r = 0;
    g = 0;
    b = 0;
  }

  analogWrite(redPin, r);
  analogWrite(greenPin, g);
  analogWrite(bluePin, b);
}

void reportValues() {
  static unsigned long lastReport = 0;
  if (millis() - lastReport >= 1000) {
    lastReport = millis();
    Serial.print("B v4 state=");
    Serial.print(systemState);
    Serial.print(" light=");
    Serial.println(sharedValue);
  }
}
